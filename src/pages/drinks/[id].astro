---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { url } from '../../utils/url';

export async function getStaticPaths() {
	const drinks = await getCollection('drinks');
	return drinks.map((drink) => ({ params: { id: drink.id }, props: { drink } }));
}

const { drink } = Astro.props as { drink: CollectionEntry<'drinks'> };
const { metadata, ingredients, cookwares, steps } = drink.data;
const { title = drink.id, ...details } = metadata;

const amount = (quantity: string | number, units = '') => [quantity, units].filter(Boolean).join(' ');
---

<Layout title={title}>
	<a href={url()} class="text-sm text-stone-500 hover:text-stone-800">← Recettes</a>
	<h1 class="mt-2 mb-4 text-3xl font-bold">{title}</h1>

	<dl class="mb-8 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
		{
			Object.entries(details).map(([key, value]) => (
				<>
					<dt class="text-stone-500">{key}</dt>
					<dd>{value}</dd>
				</>
			))
		}
	</dl>

	<div class="mb-8 grid gap-6 sm:grid-cols-2">
		<section>
			<h2 class="mb-2 text-lg font-semibold">Ingrédients</h2>
			<ul class="list-disc pl-5">
				{ingredients.map((i) => <li>{i.name} — {amount(i.quantity, i.units)}</li>)}
			</ul>
		</section>
		<section>
			<h2 class="mb-2 text-lg font-semibold">Ustensiles</h2>
			<ul class="list-disc pl-5">
				{cookwares.map((c) => <li>{c.name}</li>)}
			</ul>
		</section>
	</div>

	<h2 class="mb-2 text-lg font-semibold">Étapes</h2>
	<ol class="list-decimal space-y-2 pl-5">
		{
			steps.map((step) => (
				<li>
					{step.map((token) => {
						switch (token.type) {
							case 'text':
								return token.value;
							case 'ingredient':
								return <strong class="text-emerald-700">{token.name} ({amount(token.quantity, token.units)})</strong>;
							case 'cookware':
								return <em class="text-sky-700">{token.name}</em>;
							case 'timer':
								return <span class="rounded bg-amber-100 px-1 text-amber-800">⏱ {amount(token.quantity, token.units)}</span>;
						}
					})}
				</li>
			))
		}
	</ol>
</Layout>
