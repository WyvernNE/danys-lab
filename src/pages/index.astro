---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { url } from '../utils/url';

const drinks = await getCollection('drinks');
---

<Layout title="Labo café">
	<h1 class="mb-6 text-3xl font-bold">Recettes</h1>
	<ul class="space-y-3">
		{
			drinks.map(({ id, data }) => (
				<li>
					<a href={url(`drinks/${id}/`)} class="block rounded-lg border border-stone-200 bg-white p-4 hover:border-stone-400">
						<span class="font-medium">{data.metadata.title ?? id}</span>
						{data.metadata.description && <p class="mt-1 text-sm text-stone-500">{data.metadata.description}</p>}
					</a>
				</li>
			))
		}
	</ul>
</Layout>
